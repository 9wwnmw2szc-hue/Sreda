# Copy to /opt/sreda/app.env with mode 0600. Never commit real values.
APP_URL=https://sreda.example.ru
DATABASE_URL=postgresql://sreda:REPLACE_WITH_HEX_PASSWORD@db:5432/sreda
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
NEXT_PUBLIC_DATA_SOURCE=api
TELEGRAM_WEBHOOKS_ENABLED=false
VK_WEBHOOKS_ENABLED=false
AI_API_TOKEN=
AI_MODEL=
ATTACHMENT_STORAGE=s3
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
