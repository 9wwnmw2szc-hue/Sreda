# Identity and business data are server-side. Never commit real values.
NEXT_PUBLIC_APP_NAME=Среда
NEXT_PUBLIC_DATA_SOURCE=api
# Explicit local-only demo: NEXT_PUBLIC_DATA_SOURCE=mock (ignored in production).
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://sreda:replace_me@localhost:5432/sreda
# Generate at least 32 random bytes; no fallback secret exists.
BETTER_AUTH_SECRET=
# VK Callback API остаётся выключенным до подключения и проверки бота.
VK_WEBHOOKS_ENABLED=false
# Optional server-side post draft generation. Never use NEXT_PUBLIC_ for secrets.
AI_API_TOKEN=
AI_MODEL=
