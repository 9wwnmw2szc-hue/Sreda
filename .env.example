# Среда — переменные окружения (пример)
# Скопируйте в .env.local и заполните значения.
# Секреты (токены ботов, ключи оплаты, DB) НЕ хранить на frontend.

# Публичные URL / флаги (безопасны для клиента)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Среда

# Режим данных: mock | api (пока используется mock)
NEXT_PUBLIC_DATA_SOURCE=mock

# Будущий API (не используется на этапе 1)
# NEXT_PUBLIC_API_URL=https://api.example.com
